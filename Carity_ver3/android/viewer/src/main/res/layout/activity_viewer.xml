<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 재생 영역: 영상/이미지 + 박스 오버레이 -->
    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="76dp">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="image"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <com.guardians.viewer.ui.OverlayView
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 상단 바 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/GvButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← 목록" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrev"
            style="@style/GvButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:text="◀ 이전"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvQueue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            style="@style/GvButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="다음 ▶"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCounts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRelabel"
            style="@style/GvButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:text="다시 라벨링" />
    </LinearLayout>

    <!-- 하단 컨트롤 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_gravity="bottom"
        android:background="@color/bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlay"
            style="@style/GvButton.Primary"
            android:layout_width="64dp"
            android:layout_height="52dp"
            android:padding="0dp"
            android:text="▶"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="monospace"
            android:text="00:00 / 00:00"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/seek"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:max="1000" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeed"
            style="@style/GvButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="1.0x" />

        <CheckBox
            android:id="@+id/cbVehicle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:checked="true"
            android:text="차량"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cbPerson"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:checked="true"
            android:text="사람·이륜"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cbLane"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:checked="true"
            android:text="차선"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cbIds"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:checked="true"
            android:text="ID·점수"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 로딩(라벨링/변환/다운로드) 화면 -->
    <LinearLayout
        android:id="@+id/loadingPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="40dp">

        <ProgressBar
            android:id="@+id/pbSpinner"
            android:layout_width="72dp"
            android:layout_height="72dp" />

        <TextView
            android:id="@+id/tvLoadTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="준비 중"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoadSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSteps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/pbLoad"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="560dp"
            android:layout_height="14dp"
            android:layout_marginTop="16dp"
            android:max="1000"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/tvLoadDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLoadDevice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_pill"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/GvButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="취소" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkip"
                style="@style/GvButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="다음 파일 ▶"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
