<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <!-- 상단: 제목 + 서버 연결 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carity · 영상 라벨 뷰어"
                android:textColor="@color/text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="PC 서버에 연결하세요"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etServer"
            android:layout_width="300dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:hint="http://10.0.2.2:8765"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textColorHint="@color/text_dim"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnect"
            style="@style/GvButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="연결" />
    </LinearLayout>

    <!-- YOLO 백엔드 표시 -->
    <TextView
        android:id="@+id/tvBackend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:text="YOLO: -"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <!-- 경로 + 필터 + 기기 파일 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUp"
            style="@style/GvButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="↑ 상위 폴더" />

        <TextView
            android:id="@+id/tvPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:singleLine="true"
            android:text="/"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/filterGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            app:checkedButton="@+id/fAll"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fAll"
                style="@style/GvChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="전체" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fLabeled"
                style="@style/GvChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="라벨됨" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fUnlabeled"
                style="@style/GvChip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="미라벨" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLocal"
            style="@style/GvButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="기기 파일 열기" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:text=""
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <!-- 선택 바: 전체 선택 + 선택 분석 + 연속 재생 -->
    <LinearLayout
        android:id="@+id/selBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <CheckBox
            android:id="@+id/cbAll"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="전체 선택"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnalyze"
            style="@style/GvButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:enabled="false"
            android:text="선택 분석" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayAll"
            style="@style/GvButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:enabled="false"
            android:text="연속 재생" />

        <!-- 터치(드래그) 없이 목록 이동: 차량 화면·클릭 전용 환경용 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPageUp"
            style="@style/GvButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:text="▲ 위" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPageDown"
            style="@style/GvButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:text="▼ 아래" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBottom"
            style="@style/GvButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:text="⤓ 끝" />

        <TextView
            android:id="@+id/tvSelCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="선택 0개"
            android:textColor="@color/text_dim"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/line"
            android:dividerHeight="1dp"
            android:fastScrollEnabled="true" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="PC에서 labeling_server/run_server.bat 을 실행한 뒤 [연결]을 누르세요.\n에뮬레이터 주소: http://10.0.2.2:8765"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/pbList"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
