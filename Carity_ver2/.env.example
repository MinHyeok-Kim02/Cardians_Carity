# Carity 설정 (이 파일을 .env 로 복사해 사용. Carity.bat 이 없으면 자동 복사합니다)
# .env 는 git 에 올리지 마세요.

# ── AI 판단 ──
# Claude 키가 있으면 Claude, 비워두면 PC 의 Qwen(Ollama) 으로 판단 (키 변경 후 Carity.bat build 필요)
# 주의: 빌드된 APK 안에 키가 들어갑니다. 외부 배포용 빌드에는 넣지 마세요.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
QWEN_BASE_URL=http://10.0.2.2:11434
QWEN_MODEL=qwen2.5:3b

# ── 라벨링 서버 ──
# 영상·라벨(_labels)·변환본(_preview) 이 있는 폴더. Carity.bat copydata 후 data 로 바꾸면 통합 폴더만 사용
DATA_ROOT=D:\02. SSAFY\Hyundai Test
SERVER_PORT=8765
# 추가 옵션 예: --force-cpu --sample-fps 10
SERVER_ARGS=
LABEL_SERVER_URL=http://10.0.2.2:8765
# 이미 설치된 서버 Python 환경(.venv)이 있는 폴더. 있으면 복사하지 않고 그대로 사용 (없으면 setup 이 새로 설치)
LEGACY_SERVER=D:\02. SSAFY\Hyundai Test\labeling_server

# ── 에뮬레이터 ──
# 비우면 이름에 Pleos 가 들어간 AVD 를 자동 선택
EMULATOR_AVD=
# true 면 시작할 때마다 앱을 다시 빌드·설치
BUILD_ON_START=false
# true 면 에뮬레이터를 저장된 상태 없이 처음부터 부팅 (버튼이 안 눌릴 때. 한 번만이면 메뉴 10)
EMULATOR_COLD_BOOT=false
# Android SDK 위치 (비우면 %LOCALAPPDATA%\Android\Sdk)
ANDROID_SDK=
